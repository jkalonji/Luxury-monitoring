# Copy to .env for local runs (never commit .env). In GitHub Actions these are repository secrets/variables.

# Classification (optional: without it a rule-based classifier is used)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Storage (optional: without it data is kept in data/local.db)
SUPABASE_URL=
SUPABASE_KEY=          # service_role key, only ever used server-side (GitHub Actions)

# E-mail (Resend)
RESEND_API_KEY=
MAIL_TO=               # comma-separated recipients
MAIL_FROM=Luxury Radar <onboarding@resend.dev>

# Bluesky search (optional, an app password - not your account password)
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Link to the published dashboard, put in the e-mails
DASHBOARD_URL=https://jkalonji.github.io/Luxury-monitoring/
